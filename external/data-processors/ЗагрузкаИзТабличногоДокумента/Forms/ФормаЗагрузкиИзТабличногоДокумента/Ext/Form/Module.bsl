#Область ПрограммныйИнтерфейс

// Обработчик завершения выбора и помещения файла во временное хранилище.
&НаКлиенте
Процедура ЗаполнитьДерево(РезультатПомещения, АдресХранилища, ИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатПомещения Тогда
		Возврат;
	КонецЕсли;
	
	РасширениеФайла = ПолучитьРасширениеФайла(ИмяФайла);
	РезультатЧтения = ЗаполнитьДеревоТоваровНаСервере(АдресХранилища, РасширениеФайла);
	ПоказатьПредупреждение(, РезультатЧтения.ТекстСообщения);
	
КонецПроцедуры

// Обработчик подтверждения записи документов.
&НаКлиенте
Процедура ЗаписатьДокументыПодтверждение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РезультатЗаписи = ЗаписатьДокументыНаСервере();
	ПоказатьПредупреждение(, РезультатЗаписи.ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Обработчик команды «Прочитать».
&НаКлиенте
Процедура ПрочитатьНажатие(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьДерево", ЭтотОбъект);
	НачатьПомещениеФайла(
		Неопределено,
		Неопределено,
		Ложь,
		ОписаниеОповещения,
		Неопределено,
		"Выберите файл");
	
КонецПроцедуры

// Обработчик команды «Записать».
&НаКлиенте
Процедура ЗаписатьНажатие(Команда)
	
	Если ДеревоТоваров.Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет данных для записи. Сначала прочитайте файл.");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьДокументыПодтверждение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Записать документы?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает расширение файла без точки в нижнем регистре.
&НаКлиенте
Функция ПолучитьРасширениеФайла(ИмяФайла)
	
	МассивЧастей = СтрРазделить(НРег(ИмяФайла), ".", Ложь);
	Если МассивЧастей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат МассивЧастей[МассивЧастей.Количество() - 1];
	
КонецФункции

// Читает файл из временного хранилища и заполняет дерево товаров.
&НаСервере
Функция ЗаполнитьДеревоТоваровНаСервере(АдресХранилища, РасширениеФайла)
	
	Результат = Новый Структура("ТекстСообщения", "Данные прочитаны.");
	
	Попытка
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
		ПутьКФайлу = ПолучитьИмяВременногоФайла(РасширениеФайла);
		ДвоичныеДанные.Записать(ПутьКФайлу);
		
		// Внимание: чтение формата XLSX через ТабличныйДокумент.Прочитать
		// поддерживается не всеми версиями платформы. Для надёжной работы
		// с XLSX может потребоваться иной механизм чтения.
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		
	Исключение
		Результат.ТекстСообщения = "Не удалось прочитать файл: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	ДеревоТоваров.Очистить();
	Группы = Новый Соответствие;
	
	НачальнаяСтрока = 2;
	Для СтрокаТаблицы = НачальнаяСтрока По ТабличныйДокумент.ВысотаТаблицы Цикл
		
		НомерДокумента = ЗначениеИзЯчейки(ТабличныйДокумент, СтрокаТаблицы, 1);
		ДатаДокумента  = ЗначениеИзЯчейкиДаты(ТабличныйДокумент, СтрокаТаблицы, 2);
		Контрагент     = ЗначениеИзЯчейки(ТабличныйДокумент, СтрокаТаблицы, 3);
		Номенклатура   = ЗначениеИзЯчейки(ТабличныйДокумент, СтрокаТаблицы, 4);
		Количество     = ЗначениеИзЯчейкиЧисла(ТабличныйДокумент, СтрокаТаблицы, 5);
		Сумма          = ЗначениеИзЯчейкиЧисла(ТабличныйДокумент, СтрокаТаблицы, 6);
		
		Если ПустаяСтрока(НомерДокумента) И ПустаяСтрока(Контрагент) И ПустаяСтрока(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючГруппы = Строка(НомерДокумента) + "|" + Строка(ДатаДокумента) + "|" + Строка(Контрагент);
		РодительскийУзел = Группы.Получить(КлючГруппы);
		Если РодительскийУзел = Неопределено Тогда
			РодительскийУзел = ДеревоТоваров.Строки.Добавить();
			РодительскийУзел.НомерДокумента = НомерДокумента;
			РодительскийУзел.ДатаДокумента = ДатаДокумента;
			РодительскийУзел.Контрагент = Контрагент;
			Группы.Вставить(КлючГруппы, РодительскийУзел);
		КонецЕсли;
		
		СтрокаТовара = РодительскийУзел.Строки.Добавить();
		СтрокаТовара.Номенклатура = Номенклатура;
		СтрокаТовара.Количество = Количество;
		Цена = 0;
		Если Количество <> 0 Тогда
			Цена = Сумма / Количество;
		КонецЕсли;
		СтрокаТовара.Цена = Цена;
		СтрокаТовара.Сумма = Сумма;
		СтрокаТовара.Комментарий = "";
		СтрокаТовара.Проверено = Ложь;
		
	КонецЦикла;
	
	Результат.ТекстСообщения = "Данные прочитаны. Строк: " + Строка(ДеревоТоваров.Строки.Количество());
	Возврат Результат;
	
КонецФункции

// Возвращает строковое значение ячейки табличного документа.
&НаСервереБезКонтекста
Функция ЗначениеИзЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
	Возврат Строка(Область.Значение);
	
КонецФункции

// Возвращает число из ячейки табличного документа (0 для пустой/нечисловой).
&НаСервереБезКонтекста
Функция ЗначениеИзЯчейкиЧисла(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Значение = ЗначениеИзЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	Значение = СтрЗаменить(СтрЗаменить(Значение, " ", ""), ",", ".");
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

// Возвращает дату из ячейки табличного документа (пустую дату для неразборчивой).
&НаСервереБезКонтекста
Функция ЗначениеИзЯчейкиДаты(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Текст = ЗначениеИзЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

// Записывает документы по данным дерева товаров.
&НаСервере
Функция ЗаписатьДокументыНаСервере()
	
	Результат = Новый Структура("ЗаписаноДокументов, ТекстСообщения", 0, "");
	ЗаписаноДокументов = 0;
	МассивОшибокЗаписи = Новый Массив;
	
	Для Каждого Узел Из ДеревоТоваров.Строки Цикл
		
		Если ПустаяСтрока(Строка(Узел.НомерДокумента)) И ПустаяСтрока(Строка(Узел.Контрагент)) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = СоздатьДокументПоВиду();
		ДокументОбъект.Дата = Узел.ДатаДокумента;
		ДокументОбъект.Номер = Строка(Узел.НомерДокумента);
		
		КомментарийДокумента = "";
		ДанныеКонтрагента = НайтиКонтрагента(Строка(Узел.Контрагент));
		ДокументОбъект.Контрагент = ДанныеКонтрагента.Ссылка;
		Если НЕ ПустаяСтрока(ДанныеКонтрагента.Комментарий) Тогда
			КомментарийДокумента = ДанныеКонтрагента.Комментарий;
		КонецЕсли;
		
		СуммаДокумента = 0;
		УникальнаяНоменклатура = Новый Соответствие;
		Для Каждого СтрокаТовара Из Узел.Строки Цикл
			
			ДанныеНоменклатуры = НайтиНоменклатуру(Строка(СтрокаТовара.Номенклатура));
			
			СтрокаТЧ = ДокументОбъект.Товары.Добавить();
			СтрокаТЧ.Номенклатура = ДанныеНоменклатуры.Ссылка;
			СтрокаТЧ.Количество = СтрокаТовара.Количество;
			СтрокаТЧ.Цена = СтрокаТовара.Цена;
			СтрокаТЧ.Сумма = СтрокаТовара.Сумма;
			СтрокаТЧ.Комментарий = ДанныеНоменклатуры.Комментарий;
			СтрокаТЧ.Проверено = СтрокаТовара.Проверено;
			
			Если ДанныеНоменклатуры.Ссылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда
				УникальнаяНоменклатура.Вставить(ДанныеНоменклатуры.Ссылка, Истина);
			КонецЕсли;
			
			СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = СуммаДокумента;
		ДокументОбъект.КоличествоПозицийНоменклатуры = УникальнаяНоменклатура.Количество();
		ДокументОбъект.Комментарий = КомментарийДокумента;
		
		Попытка
			ДокументОбъект.Записать();
			ЗаписаноДокументов = ЗаписаноДокументов + 1;
		Исключение
			МассивОшибокЗаписи.Добавить("Документ " + ДокументОбъект.Номер + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Результат.ЗаписаноДокументов = ЗаписаноДокументов;
	Результат.ТекстСообщения = "Записано документов: " + Строка(ЗаписаноДокументов);
	Если МассивОшибокЗаписи.Количество() > 0 Тогда
		Результат.ТекстСообщения = Результат.ТекстСообщения
			+ Символы.ПС + "Ошибки: " + СтрСоединить(МассивОшибокЗаписи, Символы.ПС);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создаёт документ выбранного вида.
&НаСервере
Функция СоздатьДокументПоВиду()
	
	Если ВидДокумента = "Приход" Тогда
		Возврат Документы.ПриходТоваров.СоздатьДокумент();
	ИначеЕсли ВидДокумента = "Расход" Тогда
		Возврат Документы.РасходТоваров.СоздатьДокумент();
	Иначе
		ВызватьИсключение "Не выбран вид документа. Укажите Приход или Расход.";
	КонецЕсли;
	
КонецФункции

// Находит контрагента по наименованию.
&НаСервереБезКонтекста
Функция НайтиКонтрагента(Наименование)
	
	Результат = Новый Структура("Ссылка, Комментарий", Справочники.Контрагенты.ПустаяСсылка(), "");
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(Наименование);
	Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Результат.Комментарий = "Контрагент не найден: " + Наименование;
	Иначе
		Результат.Ссылка = Контрагент;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит номенклатуру по наименованию.
&НаСервереБезКонтекста
Функция НайтиНоменклатуру(Наименование)
	
	Результат = Новый Структура("Ссылка, Комментарий", Справочники.Номенклатура.ПустаяСсылка(), "");
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Наименование);
	Если Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
		Результат.Комментарий = "Номенклатура не найдена: " + Наименование;
	Иначе
		Результат.Ссылка = Номенклатура;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти