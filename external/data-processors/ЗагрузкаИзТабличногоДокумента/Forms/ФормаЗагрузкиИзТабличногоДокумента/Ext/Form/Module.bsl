&НаКлиенте
Процедура ПрочитатьНажатие(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрочитатьЗавершение", ЭтотОбъект);
	ПоказатьВводФайла(ОписаниеОповещения, "Выберите файл", "Файлы Excel (*.xls, *.xlsx)|*.xls;*.xlsx", Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьЗавершение(ВыбранныйФайл, ДополнительныеПараметры) Экспорт
	Если ВыбранныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачатьПомещениеФайла(ВыбранныйФайл, Неопределено, Истина, Новый ОписаниеОповещения("ЗаполнитьДерево", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДерево(РезультатПомещения, АдресХранилища, ИмяФайла, ДополнительныеПараметры) Экспорт
	Если НЕ РезультатПомещения Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = ИмяФайла;
	РасширениеФайла = Прав(ИмяФайла, 4);
	ЗаполнитьДеревоТоваровНаСервере(АдресХранилища, РасширениеФайла);
	Сообщить("Данные прочитаны.");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоТоваровНаСервере(АдресХранилища, РасширениеФайла)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ПутьКФайлу = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ДвоичныеДанные.Записать(ПутьКФайлу);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	// FIXME: требуется доработка
	// Проверить чтение xlsx через ТабличныйДокумент.Прочитать.
	// На платформе 8.3.27 возможны ограничения по формату,
	// при необходимости перейти на чтение xls/xlsx иными средствами.
	ТабличныйДокумент.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	ДеревоТоваров.Очистить();

	Группы = Новый Соответствие;

	НачальнаяСтрока = 2;
	Для СтрокаТаблицы = НачальнаяСтрока По ТабличныйДокумент.ВысотаТаблицы Цикл

		НомерДокумента = ЗначениеИзЯчейки(ТабличныйДокумент, СтрокаТаблицы, 1);
		ДатаДокумента = ЗначениеИзЯчейкиДаты(ТабличныйДокумент, СтрокаТаблицы, 2);
		Контрагент = ЗначениеИзЯчейки(ТабличныйДокумент, СтрокаТаблицы, 3);
		Номенклатура = ЗначениеИзЯчейки(ТабличныйДокумент, СтрокаТаблицы, 4);
		Количество = ЗначениеИзЯчейкиЧисла(ТабличныйДокумент, СтрокаТаблицы, 5);
		Сумма = ЗначениеИзЯчейкиЧисла(ТабличныйДокумент, СтрокаТаблицы, 6);

		Если ПустаяСтрока(НомерДокумента) И ПустаяСтрока(Контрагент) И ПустаяСтрока(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		КлючГруппы = Строка(НомерДокумента) + "|" + Строка(ДатаДокумента) + "|" + Строка(Контрагент);
		РодительскийУзел = Неопределено;
		Если Группы.Получить(КлючГруппы) = Неопределено Тогда
			РодительскийУзел = ДеревоТоваров.Строки.Добавить();
			РодительскийУзел.НомерДокумента = НомерДокумента;
			РодительскийУзел.ДатаДокумента = ДатаДокумента;
			РодительскийУзел.Контрагент = Контрагент;
			Группы.Вставить(КлючГруппы, РодительскийУзел);
		Иначе
			РодительскийУзел = Группы.Получить(КлючГруппы);
		КонецЕсли;

		СтрокаТовара = РодительскийУзел.Строки.Добавить();
		СтрокаТовара.Номенклатура = Номенклатура;
		СтрокаТовара.Количество = Количество;
		Цена = 0;
		Если Количество <> 0 Тогда
			Цена = Сумма / Количество;
		КонецЕсли;
		СтрокаТовара.Цена = Цена;
		СтрокаТовара.Сумма = Сумма;
		СтрокаТовара.Комментарий = "";
		СтрокаТовара.Проверено = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЗначениеИзЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
	Возврат Строка(Область.Значение);
КонецФункции

&НаСервере
Функция ЗначениеИзЯчейкиЧисла(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
	Значение = Строка(Область.Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	ЧислоЗначение = Число(СтрЗаменить(СтрЗаменить(Значение, " ", ""), ",", "."));
	Возврат ЧислоЗначение;
КонецФункции

&НаСервере
Функция ЗначениеИзЯчейкиДаты(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
	Текст = Строка(Область.Значение);
	Если ПустаяСтрока(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗаписатьНажатие(Команда)
	Если НЕ ДеревоТоваров.Строки.Количество() > 0 Тогда
		Сообщить("Нет данных для записи. Сначала прочитайте файл.");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьДокументыПодтверждение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Записать документы?", "Вопрос", "Да", "Нет");
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДокументыПодтверждение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаписатьДокументыНаСервере();
		Сообщить("Документы записаны.");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДокументыНаСервере()
	Если ВидДокумента = "Приход" Тогда
		ИмяДокумента = "ПриходТоваров";
	ИначеЕсли ВидДокумента = "Расход" Тогда
		ИмяДокумента = "РасходТоваров";
	Иначе
		ВызватьИсключение "Не выбран вид документа. Укажите Приход или Расход.";
	КонецЕсли;

	ЗаписаноДокументов = 0;
	Для Каждого Узел Из ДеревоТоваров.Строки Цикл

		Если ПустаяСтрока(Строка(Узел.НомерДокумента)) И ПустаяСтрока(Строка(Узел.Контрагент)) Тогда
			Продолжить;
		КонецЕсли;

		ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
		// FIXME: требуется доработка
		// Номер документа присваивается платформой автоматически.
		// Использование номера из файла требует дополнительного механизма
		// (РежимЗаписиДокумента / свойства регистрации). Уточнить способ.
		ДокументОбъект.Номер = Строка(Узел.НомерДокумента);
		ДокументОбъект.Дата = Узел.ДатаДокумента;

		КомментарийДокумента = "";
		КонтрагентСсылка = Неопределено;
		НаименованиеКонтрагента = Строка(Узел.Контрагент);
		Если НЕ ПустаяСтрока(НаименованиеКонтрагента) Тогда
			КонтрагентСсылка = Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента);
			Если КонтрагентСсылка = Справочники.Контрагенты.ПустаяСсылка() Тогда
				КомментарийДокумента = "Контрагент не найден: " + НаименованиеКонтрагента;
			КонецЕсли;
		КонецЕсли;
		ДокументОбъект.Контрагент = КонтрагентСсылка;

		СуммаДокумента = 0;
		СписокНоменклатуры = Новый Массив;
		Для Каждого СтрокаТовара Из Узел.Строки Цикл

			НоменклатураСсылка = Неопределено;
			НаименованиеНоменклатуры = Строка(СтрокаТовара.Номенклатура);
			Если НЕ ПустаяСтрока(НаименованиеНоменклатуры) Тогда
				НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеНоменклатуры);
				Если НоменклатураСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
					СтрокаТовара.Комментарий = "Номенклатура не найдена: " + НаименованиеНоменклатуры;
				КонецЕсли;
			КонецЕсли;

			СтрокаТЧ = ДокументОбъект.Товары.Добавить();
			СтрокаТЧ.Номенклатура = НоменклатураСсылка;
			СтрокаТЧ.Количество = СтрокаТовара.Количество;
			СтрокаТЧ.Цена = СтрокаТовара.Цена;
			СтрокаТЧ.Сумма = СтрокаТовара.Сумма;
			СтрокаТЧ.Комментарий = СтрокаТовара.Комментарий;
			СтрокаТЧ.Проверено = СтрокаТовара.Проверено;

			Если НоменклатураСсылка <> Неопределено И НоменклатураСсылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда
				ЭтоНоваяНоменклатура = Истина;
				Для Каждого СуществующаяНоменклатура Из СписокНоменклатуры Цикл
					Если СуществующаяНоменклатура = НоменклатураСсылка Тогда
						ЭтоНоваяНоменклатура = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ЭтоНоваяНоменклатура Тогда
					СписокНоменклатуры.Добавить(НоменклатураСсылка);
				КонецЕсли;
			КонецЕсли;

			СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
		КонецЦикла;

		ДокументОбъект.СуммаДокумента = СуммаДокумента;
		ДокументОбъект.КоличествоПозицийНоменклатуры = СписокНоменклатуры.Количество();
		ДокументОбъект.Комментарий = КомментарийДокумента;

		ДокументОбъект.Записать();
		ЗаписаноДокументов = ЗаписаноДокументов + 1;
	КонецЦикла;

	Сообщить("Записано документов: " + Строка(ЗаписаноДокументов));
КонецПроцедуры