#Область ПрограммныйИнтерфейс

// Обрабатывает завершение выбора и помещения файла во временное хранилище.
&НаКлиенте
Процедура ЗаполнитьДерево(РезультатПомещения, АдресХранилища, ПолноеИмяФайла, ДополнительныеПараметры) Экспорт

	ГотовоКЗаписи = Ложь;
	Если НЕ РезультатПомещения Тогда
		Возврат;
	КонецЕсли;

	РасширениеФайла = ПолучитьРасширениеФайла(ПолноеИмяФайла);
	Если РасширениеФайла <> "xls" И РасширениеФайла <> "xlsx" Тогда
		ОчиститьВременныеРесурсы("", АдресХранилища);
		ПоказатьПредупреждение(, "Поддерживаются только файлы XLS и XLSX.");
		Возврат;
	КонецЕсли;

	РезультатЧтения = ПрочитатьФайлНаСервере(АдресХранилища, РасширениеФайла);
	Если РезультатЧтения.Успех Тогда
		ИмяФайла = ПолноеИмяФайла;
		ГотовоКЗаписи = Истина;
	КонецЕсли;

	ПоказатьПредупреждение(, РезультатЧтения.ТекстСообщения);

КонецПроцедуры

// Обрабатывает подтверждение записи документов.
&НаКлиенте
Процедура ЗаписатьДокументыПодтверждение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	РезультатЗаписи = ЗаписатьДокументыНаСервере();
	Если РезультатЗаписи.Успех Тогда
		ГотовоКЗаписи = Ложь;
	КонецЕсли;

	ПоказатьПредупреждение(, РезультатЗаписи.ТекстСообщения);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Обработчик команды «Прочитать».
&НаКлиенте
Процедура ПрочитатьНажатие(Команда)

	ГотовоКЗаписи = Ложь;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьДерево", ЭтотОбъект);
	НачатьПомещениеФайла(
		Неопределено,
		Неопределено,
		Ложь,
		ОписаниеОповещения,
		Неопределено,
		"Выберите файл XLS или XLSX");

КонецПроцедуры

// Обработчик команды «Записать».
&НаКлиенте
Процедура ЗаписатьНажатие(Команда)

	Если НЕ ГотовоКЗаписи Тогда
		ПоказатьПредупреждение(, "Нет проверенных данных для записи. Сначала прочитайте файл.");
		Возврат;
	КонецЕсли;

	Если ДеревоТоваров.ПолучитьЭлементы().Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет данных для записи. Сначала прочитайте файл.");
		Возврат;
	КонецЕсли;

	Если ВидДокумента <> "Приход" И ВидДокумента <> "Расход" Тогда
		ПоказатьПредупреждение(, "Выберите вид документа: Приход или Расход.");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьДокументыПодтверждение", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		"Записать проверенные документы? Повторный импорт существующих номеров будет отклонён.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает расширение файла без точки в нижнем регистре.
&НаКлиенте
Функция ПолучитьРасширениеФайла(ПолноеИмяФайла)

	МассивЧастей = СтрРазделить(НРег(ПолноеИмяФайла), ".", Ложь);
	Если МассивЧастей.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	Возврат МассивЧастей[МассивЧастей.Количество() - 1];

КонецФункции

// Читает, проверяет и атомарно помещает данные файла в реквизит формы.
&НаСервере
Функция ПрочитатьФайлНаСервере(АдресХранилища, РасширениеФайла)

	Результат = Новый Структура("Успех, ТекстСообщения", Ложь, "");
	ПутьКФайлу = "";

	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если ДвоичныеДанные = Неопределено Тогда
			ВызватьИсключение "Файл не найден во временном хранилище.";
		КонецЕсли;
		Если ДвоичныеДанные.Размер() > 20 * 1024 * 1024 Тогда
			ВызватьИсключение "Размер файла превышает 20 МБ.";
		КонецЕсли;

		ПутьКФайлу = ПолучитьИмяВременногоФайла(РасширениеФайла);
		ДвоичныеДанные.Записать(ПутьКФайлу);

		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(
			ПутьКФайлу,
			СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОчиститьВременныеРесурсы(ПутьКФайлу, АдресХранилища);
		Результат.ТекстСообщения = "Не удалось прочитать файл: " + ТекстОшибки;
		Возврат Результат;
	КонецПопытки;

	ОчиститьВременныеРесурсы(ПутьКФайлу, АдресХранилища);

	Ошибки = Новый Массив;
	Если ТабличныйДокумент.ВысотаТаблицы > 10000 Тогда
		Ошибки.Добавить("Файл содержит более 10 000 строк.");
	КонецЕсли;
	Если ТабличныйДокумент.ШиринаТаблицы < 6 Тогда
		Ошибки.Добавить("В файле должно быть не менее шести колонок.");
	КонецЕсли;

	Если Ошибки.Количество() = 0 Тогда
		ПроверитьЗаголовкиФайла(ТабличныйДокумент, Ошибки);
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Результат.ТекстСообщения = СформироватьТекстОшибок("Файл не прошёл проверку.", Ошибки);
		Возврат Результат;
	КонецЕсли;

	НовоеДерево = СоздатьДеревоТоваров();
	ГруппыДокументов = Новый Соответствие;
	КоличествоСтрокТоваров = 0;

	Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл
		ДанныеСтроки = РазобратьСтрокуФайла(ТабличныйДокумент, НомерСтроки);
		Если ДанныеСтроки.Пустая Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ДанныеСтроки.Успех Тогда
			Ошибки.Добавить("Строка " + Строка(НомерСтроки) + ": " + ДанныеСтроки.Ошибка);
			Продолжить;
		КонецЕсли;

		КлючДокумента = НормализоватьСтроку(ДанныеСтроки.НомерДокумента);
		УзелДокумента = ГруппыДокументов.Получить(КлючДокумента);
		Если УзелДокумента = Неопределено Тогда
			УзелДокумента = НовоеДерево.Строки.Добавить();
			УзелДокумента.НомерДокумента = ДанныеСтроки.НомерДокумента;
			УзелДокумента.ДатаДокумента = ДанныеСтроки.ДатаДокумента;
			УзелДокумента.Контрагент = ДанныеСтроки.Контрагент;
			УзелДокумента.Комментарий = "";
			УзелДокумента.Проверено = Ложь;
			УзелДокумента.НомерСтрокиФайла = НомерСтроки;
			ГруппыДокументов.Вставить(КлючДокумента, УзелДокумента);
		ИначеЕсли УзелДокумента.ДатаДокумента <> ДанныеСтроки.ДатаДокумента
			Или НормализоватьСтроку(УзелДокумента.Контрагент) <> НормализоватьСтроку(ДанныеСтроки.Контрагент) Тогда
			Ошибки.Добавить(
				"Строка " + Строка(НомерСтроки)
				+ ": для номера " + ДанныеСтроки.НомерДокумента
				+ " указаны разные даты или контрагенты.");
			Продолжить;
		КонецЕсли;

		СтрокаТовара = УзелДокумента.Строки.Добавить();
		СтрокаТовара.Номенклатура = ДанныеСтроки.Номенклатура;
		СтрокаТовара.Количество = ДанныеСтроки.Количество;
		СтрокаТовара.Цена = ДанныеСтроки.Цена;
		СтрокаТовара.Сумма = ДанныеСтроки.Сумма;
		СтрокаТовара.Комментарий = "";
		СтрокаТовара.Проверено = Ложь;
		СтрокаТовара.НомерСтрокиФайла = НомерСтроки;
		КоличествоСтрокТоваров = КоличествоСтрокТоваров + 1;
	КонецЦикла;

	Если НовоеДерево.Строки.Количество() = 0 Тогда
		Ошибки.Добавить("Файл не содержит строк данных.");
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Результат.ТекстСообщения = СформироватьТекстОшибок("Файл не прошёл проверку.", Ошибки);
		Возврат Результат;
	КонецЕсли;

	ЗначениеВРеквизитФормы(НовоеДерево, "ДеревоТоваров");
	Результат.Успех = Истина;
	Результат.ТекстСообщения =
		"Данные прочитаны и проверены. Документов: "
		+ Строка(НовоеДерево.Строки.Количество())
		+ ", строк товаров: " + Строка(КоличествоСтрокТоваров) + ".";

	Возврат Результат;

КонецФункции

// Проверяет заголовки первых шести колонок файла.
&НаСервереБезКонтекста
Процедура ПроверитьЗаголовкиФайла(ТабличныйДокумент, Ошибки)

	ОжидаемыеЗаголовки = Новый Массив;
	ОжидаемыеЗаголовки.Добавить("Номер документа");
	ОжидаемыеЗаголовки.Добавить("Дата");
	ОжидаемыеЗаголовки.Добавить("Контрагент");
	ОжидаемыеЗаголовки.Добавить("Номенклатура");
	ОжидаемыеЗаголовки.Добавить("Количество");
	ОжидаемыеЗаголовки.Добавить("Сумма");

	Для Индекс = 0 По ОжидаемыеЗаголовки.Количество() - 1 Цикл
		ФактическийЗаголовок = ТекстЗначенияЯчейки(ТабличныйДокумент, 1, Индекс + 1);
		Если НормализоватьСтроку(ФактическийЗаголовок)
			<> НормализоватьСтроку(ОжидаемыеЗаголовки[Индекс]) Тогда
			Ошибки.Добавить(
				"Колонка " + Строка(Индекс + 1)
				+ ": ожидался заголовок «" + ОжидаемыеЗаголовки[Индекс]
				+ "», получено «" + ФактическийЗаголовок + "».");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Разбирает и проверяет одну строку файла.
&НаСервереБезКонтекста
Функция РазобратьСтрокуФайла(ТабличныйДокумент, НомерСтроки)

	Результат = Новый Структура;
	Результат.Вставить("Пустая", Ложь);
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("НомерДокумента", "");
	Результат.Вставить("ДатаДокумента", Дата(1, 1, 1));
	Результат.Вставить("Контрагент", "");
	Результат.Вставить("Номенклатура", "");
	Результат.Вставить("Количество", 0);
	Результат.Вставить("Цена", 0);
	Результат.Вставить("Сумма", 0);

	ЗначенияЯчеек = Новый Массив;
	Для НомерКолонки = 1 По 6 Цикл
		ЗначенияЯчеек.Добавить(ЗначениеЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки));
	КонецЦикла;

	СтрокаПустая = Истина;
	Для Каждого ЗначениеЯчейкиСтроки Из ЗначенияЯчеек Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Строка(ЗначениеЯчейкиСтроки))) Тогда
			СтрокаПустая = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрокаПустая Тогда
		Результат.Пустая = Истина;
		Возврат Результат;
	КонецЕсли;

	Ошибки = Новый Массив;
	Результат.НомерДокумента = ТекстЗначенияЯчейки(ТабличныйДокумент, НомерСтроки, 1);
	Результат.Контрагент = СокрЛП(Строка(ЗначенияЯчеек[2]));
	Результат.Номенклатура = СокрЛП(Строка(ЗначенияЯчеек[3]));

	Если ПустаяСтрока(Результат.НомерДокумента) Тогда
		Ошибки.Добавить("не заполнен номер документа");
	ИначеЕсли СтрДлина(Результат.НомерДокумента) > 9 Тогда
		Ошибки.Добавить("номер документа длиннее 9 символов");
	КонецЕсли;

	Если ПустаяСтрока(Результат.Контрагент) Тогда
		Ошибки.Добавить("не заполнен контрагент");
	ИначеЕсли СтрДлина(Результат.Контрагент) > 25 Тогда
		Ошибки.Добавить("наименование контрагента длиннее 25 символов");
	КонецЕсли;

	Если ПустаяСтрока(Результат.Номенклатура) Тогда
		Ошибки.Добавить("не заполнена номенклатура");
	ИначеЕсли СтрДлина(Результат.Номенклатура) > 25 Тогда
		Ошибки.Добавить("наименование номенклатуры длиннее 25 символов");
	КонецЕсли;

	РезультатДаты = РазобратьДату(ЗначенияЯчеек[1]);
	Если РезультатДаты.Успех Тогда
		Результат.ДатаДокумента = РезультатДаты.Значение;
	Иначе
		Ошибки.Добавить("дата: " + РезультатДаты.Ошибка);
	КонецЕсли;

	РезультатКоличества = РазобратьЧисло(ЗначенияЯчеек[4]);
	Если РезультатКоличества.Успех Тогда
		Результат.Количество = РезультатКоличества.Значение;
		Если Результат.Количество <= 0 Тогда
			Ошибки.Добавить("количество должно быть больше нуля");
		ИначеЕсли АбсолютноеЗначение(Результат.Количество) > 9999999.999 Тогда
			Ошибки.Добавить("количество превышает разрядность документа");
		ИначеЕсли Окр(Результат.Количество, 3) <> Результат.Количество Тогда
			Ошибки.Добавить("количество содержит более трёх знаков после запятой");
		КонецЕсли;
	Иначе
		Ошибки.Добавить("количество: " + РезультатКоличества.Ошибка);
	КонецЕсли;

	РезультатСуммы = РазобратьЧисло(ЗначенияЯчеек[5]);
	Если РезультатСуммы.Успех Тогда
		Результат.Сумма = РезультатСуммы.Значение;
		Если Результат.Сумма < 0 Тогда
			Ошибки.Добавить("сумма не может быть отрицательной");
		ИначеЕсли АбсолютноеЗначение(Результат.Сумма) > 99999999.99 Тогда
			Ошибки.Добавить("сумма превышает разрядность документа");
		ИначеЕсли Окр(Результат.Сумма, 2) <> Результат.Сумма Тогда
			Ошибки.Добавить("сумма содержит более двух знаков после запятой");
		КонецЕсли;
	Иначе
		Ошибки.Добавить("сумма: " + РезультатСуммы.Ошибка);
	КонецЕсли;

	Если Результат.Количество > 0 Тогда
		Результат.Цена = Окр(Результат.Сумма / Результат.Количество, 2);
		Если АбсолютноеЗначение(Результат.Цена) > 99999999.99 Тогда
			Ошибки.Добавить("цена превышает разрядность документа");
		КонецЕсли;
	КонецЕсли;

	Результат.Успех = Ошибки.Количество() = 0;
	Если НЕ Результат.Успех Тогда
		Результат.Ошибка = СтрСоединить(Ошибки, "; ");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает фактическое значение ячейки табличного документа.
&НаСервереБезКонтекста
Функция ЗначениеЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки)

	Возврат ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Значение;

КонецФункции

// Возвращает строковое представление значения ячейки.
&НаСервереБезКонтекста
Функция ТекстЗначенияЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки)

	Возврат СокрЛП(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст);

КонецФункции

// Разбирает дату без подстановки фиктивного значения при ошибке.
&НаСервереБезКонтекста
Функция РазобратьДату(ИсходноеЗначение)

	Результат = Новый Структура("Успех, Значение, Ошибка", Ложь, Дата(1, 1, 1), "неверный формат");
	Если ТипЗнч(ИсходноеЗначение) = Тип("Дата") Тогда
		Если ИсходноеЗначение <> Дата(1, 1, 1) Тогда
			Результат.Успех = Истина;
			Результат.Значение = НачалоДня(ИсходноеЗначение);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ТекстДаты = СокрЛП(Строка(ИсходноеЗначение));
	Если ПустаяСтрока(ТекстДаты) Тогда
		Результат.Ошибка = "значение не заполнено";
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(ТекстДаты) = 10
		И Сред(ТекстДаты, 5, 1) = "-"
		И Сред(ТекстДаты, 8, 1) = "-" Тогда
		Попытка
			Результат.Значение = Дата(
				Число(Лев(ТекстДаты, 4)),
				Число(Сред(ТекстДаты, 6, 2)),
				Число(Прав(ТекстДаты, 2)));
			Результат.Успех = Истина;
			Возврат Результат;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Попытка
		Результат.Значение = НачалоДня(Дата(ТекстДаты));
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "ожидалась дата в формате ГГГГ-ММ-ДД или значение типа Дата";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Разбирает число с учётом наиболее распространённых разделителей.
&НаСервереБезКонтекста
Функция РазобратьЧисло(ИсходноеЗначение)

	Результат = Новый Структура("Успех, Значение, Ошибка", Ложь, 0, "неверный формат");
	Если ТипЗнч(ИсходноеЗначение) = Тип("Число") Тогда
		Результат.Успех = Истина;
		Результат.Значение = ИсходноеЗначение;
		Возврат Результат;
	КонецЕсли;

	ИсходныйТекст = СокрЛП(Строка(ИсходноеЗначение));
	Если ПустаяСтрока(ИсходныйТекст) Тогда
		Результат.Ошибка = "значение не заполнено";
		Возврат Результат;
	КонецЕсли;

	ИсходныйТекст = СтрЗаменить(ИсходныйТекст, " ", "");
	ИсходныйТекст = СтрЗаменить(ИсходныйТекст, Символ(160), "");
	Представления = Новый Массив;
	Представления.Добавить(ИсходныйТекст);
	Представления.Добавить(СтрЗаменить(ИсходныйТекст, ",", "."));
	Представления.Добавить(СтрЗаменить(ИсходныйТекст, ".", ","));

	Для Каждого ПредставлениеЧисла Из Представления Цикл
		Попытка
			Результат.Значение = Число(ПредставлениеЧисла);
			Результат.Успех = Истина;
			Возврат Результат;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт дерево значений, соответствующее реквизиту управляемой формы.
&НаСервереБезКонтекста
Функция СоздатьДеревоТоваров()

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("НомерДокумента");
	Дерево.Колонки.Добавить("ДатаДокумента");
	Дерево.Колонки.Добавить("Контрагент");
	Дерево.Колонки.Добавить("Номенклатура");
	Дерево.Колонки.Добавить("Количество");
	Дерево.Колонки.Добавить("Цена");
	Дерево.Колонки.Добавить("Сумма");
	Дерево.Колонки.Добавить("Комментарий");
	Дерево.Колонки.Добавить("Проверено");
	Дерево.Колонки.Добавить("НомерСтрокиФайла");

	Возврат Дерево;

КонецФункции

// Записывает проверенные документы одной транзакцией.
&НаСервере
Функция ЗаписатьДокументыНаСервере()

	Результат = Новый Структура("Успех, ЗаписаноДокументов, ТекстСообщения", Ложь, 0, "");
	Ошибки = Новый Массив;

	Если ВидДокумента <> "Приход" И ВидДокумента <> "Расход" Тогда
		Ошибки.Добавить("Не выбран вид документа: Приход или Расход.");
	КонецЕсли;

	Дерево = РеквизитФормыВЗначение("ДеревоТоваров");
	ДанныеПроверки = ПроверитьДеревоПередЗаписью(Дерево, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		Результат.ТекстСообщения = СформироватьТекстОшибок("Данные не прошли проверку.", Ошибки);
		Возврат Результат;
	КонецЕсли;

	Контрагенты = ПолучитьКонтрагентов(ДанныеПроверки.Контрагенты);
	Номенклатура = ПолучитьНоменклатуру(ДанныеПроверки.Номенклатура);
	ПроверитьСсылкиСправочников(Дерево, Контрагенты, Номенклатура, Ошибки);

	Если Ошибки.Количество() > 0 Тогда
		Результат.ТекстСообщения = СформироватьТекстОшибок("Документы не записаны.", Ошибки);
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДокументыИмпорта(ВидДокумента);
		СуществующиеДокументы = ПолучитьСуществующиеДокументы(
			ВидДокумента,
			ДанныеПроверки.НомераДокументов);
		Для Каждого УзелДокумента Из Дерево.Строки Цикл
			Если СуществующиеДокументы.Получить(
				НормализоватьСтроку(УзелДокумента.НомерДокумента)) <> Неопределено Тогда
				Ошибки.Добавить(
					"Документ с номером " + Строка(УзелДокумента.НомерДокумента)
					+ " уже существует. Повторный импорт запрещён.");
			КонецЕсли;
		КонецЦикла;

		Если Ошибки.Количество() > 0 Тогда
			ОтменитьТранзакцию();
			Результат.ТекстСообщения = СформироватьТекстОшибок("Документы не записаны.", Ошибки);
			Возврат Результат;
		КонецЕсли;

		Для Каждого УзелДокумента Из Дерево.Строки Цикл
			ДокументОбъект = СоздатьДокументПоВиду(ВидДокумента);
			ДокументОбъект.Номер = Строка(УзелДокумента.НомерДокумента);
			ДокументОбъект.Дата = УзелДокумента.ДатаДокумента;
			ДокументОбъект.Контрагент = Контрагенты.Ссылки.Получить(
				НормализоватьСтроку(УзелДокумента.Контрагент));
			ДокументОбъект.Комментарий = Строка(УзелДокумента.Комментарий);

			СуммаДокумента = 0;
			УникальнаяНоменклатура = Новый Соответствие;
			Для Каждого СтрокаТовара Из УзелДокумента.Строки Цикл
				СсылкаНоменклатуры = Номенклатура.Ссылки.Получить(
					НормализоватьСтроку(СтрокаТовара.Номенклатура));

				СтрокаТабличнойЧасти = ДокументОбъект.Товары.Добавить();
				СтрокаТабличнойЧасти.Номенклатура = СсылкаНоменклатуры;
				СтрокаТабличнойЧасти.Количество = СтрокаТовара.Количество;
				СтрокаТабличнойЧасти.Цена = СтрокаТовара.Цена;
				СтрокаТабличнойЧасти.Сумма = СтрокаТовара.Сумма;
				СтрокаТабличнойЧасти.Комментарий = Строка(СтрокаТовара.Комментарий);
				СтрокаТабличнойЧасти.Проверено = СтрокаТовара.Проверено;

				УникальнаяНоменклатура.Вставить(СсылкаНоменклатуры, Истина);
				СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
			КонецЦикла;

			ДокументОбъект.СуммаДокумента = СуммаДокумента;
			ДокументОбъект.КоличествоПозицийНоменклатуры = УникальнаяНоменклатура.Количество();
			ДокументОбъект.Записать();
			Результат.ЗаписаноДокументов = Результат.ЗаписаноДокументов + 1;
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОписаниеОшибки();
		Результат.ЗаписаноДокументов = 0;
		Результат.ТекстСообщения = "Документы не записаны. Транзакция отменена: " + ТекстОшибки;
		Возврат Результат;
	КонецПопытки;

	ГотовоКЗаписи = Ложь;
	Результат.Успех = Истина;
	Результат.ТекстСообщения = "Записано документов: " + Строка(Результат.ЗаписаноДокументов) + ".";
	Возврат Результат;

КонецФункции

// Проверяет отредактированное пользователем дерево перед обращением к базе.
&НаСервереБезКонтекста
Функция ПроверитьДеревоПередЗаписью(Дерево, Ошибки)

	Результат = Новый Структура;
	Результат.Вставить("НомераДокументов", Новый Массив);
	Результат.Вставить("Контрагенты", Новый Массив);
	Результат.Вставить("Номенклатура", Новый Массив);

	УникальныеНомера = Новый Соответствие;
	УникальныеКонтрагенты = Новый Соответствие;
	УникальнаяНоменклатура = Новый Соответствие;

	Если Дерево.Строки.Количество() = 0 Тогда
		Ошибки.Добавить("Дерево товаров пусто.");
		Возврат Результат;
	КонецЕсли;

	Для Каждого УзелДокумента Из Дерево.Строки Цикл
		НомерСтроки = УзелДокумента.НомерСтрокиФайла;
		НомерДокумента = СокрЛП(Строка(УзелДокумента.НомерДокумента));
		КлючНомера = НормализоватьСтроку(НомерДокумента);

		Если ПустаяСтрока(НомерДокумента) Тогда
			Ошибки.Добавить("Строка " + Строка(НомерСтроки) + ": не заполнен номер документа.");
		ИначеЕсли СтрДлина(НомерДокумента) > 9 Тогда
			Ошибки.Добавить("Строка " + Строка(НомерСтроки) + ": номер длиннее 9 символов.");
		ИначеЕсли УникальныеНомера.Получить(КлючНомера) <> Неопределено Тогда
			Ошибки.Добавить("Номер " + НомерДокумента + " представлен несколькими корневыми узлами.");
		Иначе
			УникальныеНомера.Вставить(КлючНомера, Истина);
			Результат.НомераДокументов.Добавить(НомерДокумента);
		КонецЕсли;

		Если УзелДокумента.ДатаДокумента = Дата(1, 1, 1) Тогда
			Ошибки.Добавить("Документ " + НомерДокумента + ": не заполнена дата.");
		КонецЕсли;

		Контрагент = СокрЛП(Строка(УзелДокумента.Контрагент));
		Если ПустаяСтрока(Контрагент) Тогда
			Ошибки.Добавить("Документ " + НомерДокумента + ": не заполнен контрагент.");
		Иначе
			ДобавитьУникальноеЗначение(Контрагент, УникальныеКонтрагенты, Результат.Контрагенты);
		КонецЕсли;

		Если УзелДокумента.Строки.Количество() = 0 Тогда
			Ошибки.Добавить("Документ " + НомерДокумента + " не содержит товаров.");
		КонецЕсли;

		СуммаДокумента = 0;
		Для Каждого СтрокаТовара Из УзелДокумента.Строки Цикл
			НомерСтрокиТовара = СтрокаТовара.НомерСтрокиФайла;
			НаименованиеНоменклатуры = СокрЛП(Строка(СтрокаТовара.Номенклатура));
			Если ПустаяСтрока(НаименованиеНоменклатуры) Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": не заполнена номенклатура.");
			Иначе
				ДобавитьУникальноеЗначение(
					НаименованиеНоменклатуры,
					УникальнаяНоменклатура,
					Результат.Номенклатура);
			КонецЕсли;

			Если СтрокаТовара.Количество <= 0 Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": количество должно быть больше нуля.");
			ИначеЕсли АбсолютноеЗначение(СтрокаТовара.Количество) > 9999999.999 Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": количество превышает разрядность документа.");
			ИначеЕсли Окр(СтрокаТовара.Количество, 3) <> СтрокаТовара.Количество Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": количество содержит более трёх знаков после запятой.");
			КонецЕсли;
			Если СтрокаТовара.Сумма < 0 Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": сумма не может быть отрицательной.");
			ИначеЕсли АбсолютноеЗначение(СтрокаТовара.Сумма) > 99999999.99 Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": сумма превышает разрядность документа.");
			ИначеЕсли Окр(СтрокаТовара.Сумма, 2) <> СтрокаТовара.Сумма Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": сумма содержит более двух знаков после запятой.");
			КонецЕсли;
			Если СтрокаТовара.Цена < 0 Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": цена не может быть отрицательной.");
			ИначеЕсли АбсолютноеЗначение(СтрокаТовара.Цена) > 99999999.99 Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": цена превышает разрядность документа.");
			ИначеЕсли Окр(СтрокаТовара.Цена, 2) <> СтрокаТовара.Цена Тогда
				Ошибки.Добавить("Строка " + Строка(НомерСтрокиТовара) + ": цена содержит более двух знаков после запятой.");
			КонецЕсли;
			Если АбсолютноеЗначение(Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2) - СтрокаТовара.Сумма) > 0.01 Тогда
				Ошибки.Добавить(
					"Строка " + Строка(НомерСтрокиТовара)
					+ ": сумма не соответствует количеству и цене.");
			КонецЕсли;
			СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма;
		КонецЦикла;

		Если АбсолютноеЗначение(СуммаДокумента) > 99999999.99 Тогда
			Ошибки.Добавить("Документ " + НомерДокумента + ": итоговая сумма превышает разрядность документа.");
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сериализует импорт документов одного вида в пределах транзакции.
&НаСервереБезКонтекста
Процедура ЗаблокироватьДокументыИмпорта(ВидДокумента)

	Блокировка = Новый БлокировкаДанных;
	Если ВидДокумента = "Приход" Тогда
		ЭлементБлокировки = Блокировка.Добавить("Документ.ПриходТоваров");
	Иначе
		ЭлементБлокировки = Блокировка.Добавить("Документ.РасходТоваров");
	КонецЕсли;

	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

// Добавляет строковое значение в массив один раз.
&НаСервереБезКонтекста
Процедура ДобавитьУникальноеЗначение(Значение, УникальныеЗначения, МассивЗначений)

	Ключ = НормализоватьСтроку(Значение);
	Если УникальныеЗначения.Получить(Ключ) = Неопределено Тогда
		УникальныеЗначения.Вставить(Ключ, Истина);
		МассивЗначений.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

// Получает однозначные ссылки контрагентов одним запросом.
&НаСервереБезКонтекста
Функция ПолучитьКонтрагентов(Наименования)

	Результат = Новый Структура("Ссылки, Дубли", Новый Соответствие, Новый Соответствие);
	Если Наименования.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Контрагенты.Ссылка КАК Ссылка,
		| Контрагенты.Наименование КАК Наименование
		|ИЗ
		| Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		| НЕ Контрагенты.ПометкаУдаления
		| И Контрагенты.Наименование В (&Наименования)";
	Запрос.УстановитьПараметр("Наименования", Наименования);

	ЗаполнитьСоответствиеСсылок(Запрос.Выполнить().Выбрать(), Результат);
	Возврат Результат;

КонецФункции

// Получает однозначные ссылки элементов номенклатуры одним запросом.
&НаСервереБезКонтекста
Функция ПолучитьНоменклатуру(Наименования)

	Результат = Новый Структура("Ссылки, Дубли", Новый Соответствие, Новый Соответствие);
	Если Наименования.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Номенклатура.Ссылка КАК Ссылка,
		| Номенклатура.Наименование КАК Наименование
		|ИЗ
		| Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		| НЕ Номенклатура.ПометкаУдаления
		| И НЕ Номенклатура.ЭтоГруппа
		| И Номенклатура.Наименование В (&Наименования)";
	Запрос.УстановитьПараметр("Наименования", Наименования);

	ЗаполнитьСоответствиеСсылок(Запрос.Выполнить().Выбрать(), Результат);
	Возврат Результат;

КонецФункции

// Заполняет соответствия ссылок и неоднозначных наименований из выборки запроса.
&НаСервереБезКонтекста
Процедура ЗаполнитьСоответствиеСсылок(Выборка, Результат)

	Пока Выборка.Следующий() Цикл
		Ключ = НормализоватьСтроку(Выборка.Наименование);
		Если Результат.Ссылки.Получить(Ключ) = Неопределено Тогда
			Результат.Ссылки.Вставить(Ключ, Выборка.Ссылка);
		Иначе
			Результат.Дубли.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет, что все ссылки справочников найдены однозначно.
&НаСервереБезКонтекста
Процедура ПроверитьСсылкиСправочников(Дерево, Контрагенты, Номенклатура, Ошибки)

	ПроверенныеКонтрагенты = Новый Соответствие;
	ПровереннаяНоменклатура = Новый Соответствие;

	Для Каждого УзелДокумента Из Дерево.Строки Цикл
		Контрагент = СокрЛП(Строка(УзелДокумента.Контрагент));
		КлючКонтрагента = НормализоватьСтроку(Контрагент);
		Если ПроверенныеКонтрагенты.Получить(КлючКонтрагента) = Неопределено Тогда
			ПроверенныеКонтрагенты.Вставить(КлючКонтрагента, Истина);
			Если Контрагенты.Дубли.Получить(КлючКонтрагента) = Истина Тогда
				Ошибки.Добавить("Контрагент найден неоднозначно: " + Контрагент + ".");
			ИначеЕсли Контрагенты.Ссылки.Получить(КлючКонтрагента) = Неопределено Тогда
				Ошибки.Добавить("Контрагент не найден: " + Контрагент + ".");
			КонецЕсли;
		КонецЕсли;

		Для Каждого СтрокаТовара Из УзелДокумента.Строки Цикл
			НаименованиеНоменклатуры = СокрЛП(Строка(СтрокаТовара.Номенклатура));
			КлючНоменклатуры = НормализоватьСтроку(НаименованиеНоменклатуры);
			Если ПровереннаяНоменклатура.Получить(КлючНоменклатуры) = Неопределено Тогда
				ПровереннаяНоменклатура.Вставить(КлючНоменклатуры, Истина);
				Если Номенклатура.Дубли.Получить(КлючНоменклатуры) = Истина Тогда
					Ошибки.Добавить("Номенклатура найдена неоднозначно: " + НаименованиеНоменклатуры + ".");
				ИначеЕсли Номенклатура.Ссылки.Получить(КлючНоменклатуры) = Неопределено Тогда
					Ошибки.Добавить("Номенклатура не найдена: " + НаименованиеНоменклатуры + ".");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Возвращает существующие документы выбранного вида по номерам.
&НаСервереБезКонтекста
Функция ПолучитьСуществующиеДокументы(ВидДокумента, НомераДокументов)

	Результат = Новый Соответствие;
	Если НомераДокументов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ВидДокумента = "Приход" Тогда
		ИмяДокумента = "ПриходТоваров";
	Иначе
		ИмяДокумента = "РасходТоваров";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| ДокументыИмпорта.Ссылка КАК Ссылка,
		| ДокументыИмпорта.Номер КАК Номер
		|ИЗ
		| Документ." + ИмяДокумента + " КАК ДокументыИмпорта
		|ГДЕ
		| ДокументыИмпорта.Номер В (&НомераДокументов)";
	Запрос.УстановитьПараметр("НомераДокументов", НомераДокументов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(НормализоватьСтроку(Выборка.Номер), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт объект документа выбранного вида.
&НаСервереБезКонтекста
Функция СоздатьДокументПоВиду(ВидДокумента)

	Если ВидДокумента = "Приход" Тогда
		Возврат Документы.ПриходТоваров.СоздатьДокумент();
	ИначеЕсли ВидДокумента = "Расход" Тогда
		Возврат Документы.РасходТоваров.СоздатьДокумент();
	КонецЕсли;

	ВызватьИсключение "Не выбран вид документа. Укажите Приход или Расход.";

КонецФункции

// Возвращает нормализованный ключ для строкового поиска.
&НаСервереБезКонтекста
Функция НормализоватьСтроку(Значение)

	Возврат ВРег(СокрЛП(Строка(Значение)));

КонецФункции

// Возвращает модуль числа без зависимости от имени встроенной функции платформы.
&НаСервереБезКонтекста
Функция АбсолютноеЗначение(Значение)

	Если Значение < 0 Тогда
		Возврат -Значение;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Формирует ограниченный по длине текст диагностических сообщений.
&НаСервереБезКонтекста
Функция СформироватьТекстОшибок(Заголовок, Ошибки)

	КоличествоВыводимыхОшибок = Ошибки.Количество();
	Если КоличествоВыводимыхОшибок > 20 Тогда
		КоличествоВыводимыхОшибок = 20;
	КонецЕсли;

	СтрокиСообщения = Новый Массив;
	Для Индекс = 0 По КоличествоВыводимыхОшибок - 1 Цикл
		СтрокиСообщения.Добавить(Ошибки[Индекс]);
	КонецЦикла;

	ТекстСообщения = Заголовок;
	Если СтрокиСообщения.Количество() > 0 Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + СтрСоединить(СтрокиСообщения, Символы.ПС);
	КонецЕсли;
	Если Ошибки.Количество() > КоличествоВыводимыхОшибок Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС
			+ "Не показано ошибок: "
			+ Строка(Ошибки.Количество() - КоличествоВыводимыхОшибок) + ".";
	КонецЕсли;

	Возврат ТекстСообщения;

КонецФункции

// Удаляет серверный временный файл и значение из временного хранилища.
&НаСервереБезКонтекста
Процедура ОчиститьВременныеРесурсы(ПутьКФайлу, АдресХранилища)

	Если НЕ ПустаяСтрока(ПутьКФайлу) Тогда
		Попытка
			УдалитьФайлы(ПутьКФайлу);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(АдресХранилища) Тогда
		Попытка
			УдалитьИзВременногоХранилища(АдресХранилища);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
